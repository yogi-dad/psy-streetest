# Firebase Configuration
# Get these from https://console.firebase.google.com/project/_/settings/general
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Apps Script Configuration
# Deployment URL from Google Apps Script (Web App)
# Get this from: Google Apps Script Project → Deploy → New Deployment → Select Web App
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/d/YOUR_SCRIPT_ID/userwithlogin
